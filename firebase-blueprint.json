{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Chess player registered in the federation database",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the chess player",
          "maxLength": 150
        },
        "title": {
          "type": "string",
          "description": "Chess title (e.g., GM, IM, FM, CM, WGM, WIM, WFM, WCM, MN, S/T)",
          "maxLength": 20
        },
        "birthDate": {
          "type": "string",
          "description": "Date of birth in YYYY-MM-DD format",
          "maxLength": 10
        },
        "gender": {
          "type": "string",
          "description": "Gender: M (Masculino), F (Feminino), Outro",
          "enum": ["M", "F", "Outro"]
        },
        "fideId": {
          "type": "string",
          "description": "Official FIDE Identification Number",
          "maxLength": 30
        },
        "cbxId": {
          "type": "string",
          "description": "Official CBX Identification Number",
          "maxLength": 30
        },
        "country": {
          "type": "string",
          "description": "Country of origin / federation (e.g. BRA, ARG, USA)",
          "maxLength": 60
        },
        "state": {
          "type": "string",
          "description": "State / UF of affiliation (e.g. SP, RJ, MG, RS, SC, PR)",
          "maxLength": 30
        },
        "fideUrl": {
          "type": "string",
          "description": "Profile URL on the official FIDE website",
          "maxLength": 300
        },
        "cbxUrl": {
          "type": "string",
          "description": "Profile URL on the official CBX website",
          "maxLength": 300
        },
        "ratingFide": {
          "type": "number",
          "description": "FIDE Elo Standard rating"
        },
        "ratingFideStandard": {
          "type": "number",
          "description": "FIDE Elo Standard rating"
        },
        "ratingFideRapid": {
          "type": "number",
          "description": "FIDE Elo Rapid rating"
        },
        "ratingFideBlitz": {
          "type": "number",
          "description": "FIDE Elo Blitz rating"
        },
        "ratingCbx": {
          "type": "number",
          "description": "CBX Elo Standard rating"
        },
        "ratingCbxStandard": {
          "type": "number",
          "description": "CBX Elo Standard rating"
        },
        "ratingCbxRapid": {
          "type": "number",
          "description": "CBX Elo Rapid rating"
        },
        "ratingCbxBlitz": {
          "type": "number",
          "description": "CBX Elo Blitz rating"
        },
        "club": {
          "type": "string",
          "description": "Chess club or association",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp ISO string"
        }
      },
      "required": ["name", "title", "birthDate", "gender", "country", "state"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Chess tournament registry with participants and standings",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tournament name",
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "description": "City where tournament takes place",
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "description": "State / UF",
          "maxLength": 30
        },
        "startDate": {
          "type": "string",
          "description": "Start date YYYY-MM-DD",
          "maxLength": 10
        },
        "endDate": {
          "type": "string",
          "description": "End date YYYY-MM-DD",
          "maxLength": 10
        },
        "rounds": {
          "type": "number",
          "description": "Total number of rounds"
        },
        "timeControl": {
          "type": "string",
          "description": "Time control description",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "description": "Tournament status",
          "enum": ["Planejado", "Em Andamento", "Finalizado"]
        },
        "arbiters": {
          "type": "string",
          "description": "Chief and deputy arbiters",
          "maxLength": 150
        },
        "organizer": {
          "type": "string",
          "description": "Organizer club / federation",
          "maxLength": 150
        },
        "participants": {
          "type": "array",
          "description": "List of participant player IDs"
        },
        "standings": {
          "type": "array",
          "description": "Standings with player scores and tiebreakers"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp ISO string"
        }
      },
      "required": ["name", "startDate", "status"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Collection of registered chess players"
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Collection of chess tournaments and results"
    }
  }
}
